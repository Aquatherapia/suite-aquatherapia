# Copia este archivo a .env.local y pon tu clave gratuita de Google Gemini
# Se obtiene en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...

# Clave de la web: sirve para entrar la primera vez (usuario «admin») y crear los usuarios en Administración.
# Después cada persona entra con su usuario. También firma las sesiones si no hay SESSION_SECRET.
SITE_PASSWORD=...

# Clave que Vercel Cron manda para lanzar la revisión de las 5:00 (obligatoria en Vercel:
# sin ella la revisión programada no arranca). Cualquier texto largo y aleatorio.
CRON_SECRET=...

# Opcional: clave para firmar la cookie de sesión. Si no está, se usa SITE_PASSWORD (+ KV_REST_API_TOKEN).
# Cambiarla (o cambiar SITE_PASSWORD) cierra todas las sesiones abiertas.
# SESSION_SECRET=...

# Conexión con Google (fichas, Search Console y Analytics). Ver GOOGLE.md
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
# Opcional: solo si la dirección de vuelta no es <dominio>/api/google/callback
# GOOGLE_REDIRECT_URI=https://suite-aquatherapia.vercel.app/api/google/callback
