# Copia este archivo a .env.local y pon tu clave gratuita de Google Gemini
# Se obtiene en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...

# Clave de acceso a toda la suite (se pide en /login)
SITE_PASSWORD=...

# Conexión con Google (fichas, Search Console y Analytics). Ver GOOGLE.md
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
# Opcional: solo si la dirección de vuelta no es <dominio>/api/google/callback
# GOOGLE_REDIRECT_URI=https://suite-aquatherapia.vercel.app/api/google/callback
